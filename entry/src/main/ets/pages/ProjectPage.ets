import { copyText } from '../components/Clipboard'
import { Project, Version, VersionMetrics, store } from '../vera/ProjectStore'
import { refreshForms } from '../vera/FormUpdater'
import { projectIconResource } from '../vera/ProjectIcons'
import { IconPicker } from '../components/IconPicker'
import { confirmDeleteProject } from '../components/ProjectRows'
import { requestHeadline, changeNote, versionCountText } from '../vera/ProjectText'
import { projectOperations, ProjectOperationStatus, ProjectShortcutState } from '../vera/ProjectOperations'
import { common } from '@kit.AbilityKit'
import { app, PrimaryButton, TonalButton, QuietButton, DangerButton } from '../components/AppStyle'
import { AppRouteParams, returnToLibrary } from '../vera/AppNavigation'
import { settingsMenuItem } from '../components/SettingsEntry'
import { publishLiveWidget, WIDGET_ADDED } from '../vera/LiveWidgetPublish'
import { formBindings } from '../vera/FormBindings'
import { veraStateStamp } from '../vera/VeraStateStamp'
import { WidgetPreview } from '../components/WidgetPreview'
import { WidgetStatus, widgetStatus, WIDGET_NONE, WIDGET_READY, WIDGET_PLACED, WIDGET_BROKEN, WIDGET_NEEDS_RUN,
  WIDGET_UNAVAILABLE } from '../vera/WidgetStatus'
import { removeWidget, WIDGET_REMOVED_NOTE } from '../vera/WidgetRemove'

@CustomDialog
struct ProjectPanelDialog {
  controller?: CustomDialogController

  @Builder
  emptyContent() {}

  @BuilderParam content: () => void = this.emptyContent

  build() {
    Column() {
      this.content()
    }
    .width('100%')
  }
}

@Component
export struct ProjectPage {
  params: AppRouteParams = new AppRouteParams()

  @Consume('navPathStack') pathStack: NavPathStack

  @State project: Project | null = null
  @State versions: Version[] = []
  @State projectId: string = ''
  @State projectOperationPending: boolean = false
  @State shortcutOperation: string = ''
  @State shortcutState: ProjectShortcutState = ProjectShortcutState.Unknown
  private shortcutRefreshGeneration: number = 0
  private pageVisible: boolean = false
  private returningToIndex: boolean = false
  @State viewedSource: string = ''
  @State viewedVersionNumber: number = 0
  @State viewedMetricsVersion: Version | null = null
  @State viewedMetricsNumber: number = 0
  // Shown beside the source: the request a version came from is the thing you
  // actually need when deciding whether to refine it or start again.
  @State viewedPrompt: string = ''
  @State renameText: string = ''
  @State renameComposing: boolean = false
  private renameInputController: TextInputController = new TextInputController()
  /** The home-screen widget: what it is now, and the latest version and data its thumbnail draws. */
  @State widget: WidgetStatus = new WidgetStatus()
  @State widgetVbc2: string = ''
  @State widgetSeed: string = ''
  private activePanel: string = ''

  private sourceController: CustomDialogController = new CustomDialogController({
    builder: ProjectPanelDialog({ content: this.sourceDialog }),
    autoCancel: true,
    isModal: true,
    alignment: DialogAlignment.Center,
    customStyle: true,
    maskColor: '#50000000',
    cancel: () => { this.clearPanels() }
  })

  private metricsController: CustomDialogController = new CustomDialogController({
    builder: ProjectPanelDialog({ content: this.metricsDialog }),
    autoCancel: true,
    isModal: true,
    alignment: DialogAlignment.Center,
    customStyle: true,
    maskColor: '#50000000',
    cancel: () => { this.clearPanels() }
  })

  private renameController: CustomDialogController = new CustomDialogController({
    builder: ProjectPanelDialog({ content: this.renameDialog }),
    autoCancel: true,
    isModal: true,
    alignment: DialogAlignment.Center,
    customStyle: true,
    maskColor: '#50000000',
    cancel: () => { this.clearPanels() }
  })

  private widgetController: CustomDialogController = new CustomDialogController({
    builder: ProjectPanelDialog({ content: this.widgetDialog }),
    autoCancel: true,
    isModal: true,
    alignment: DialogAlignment.Center,
    customStyle: true,
    maskColor: '#50000000',
    cancel: () => { this.clearPanels() }
  })

  private iconController: CustomDialogController = new CustomDialogController({
    builder: ProjectPanelDialog({ content: this.iconDialog }),
    autoCancel: true,
    isModal: true,
    alignment: DialogAlignment.Center,
    customStyle: true,
    maskColor: '#50000000',
    cancel: () => { this.clearPanels() }
  })

  aboutToAppear(): void {
    this.projectId = this.params.projectId
  }

  destinationShown(): void {
    this.pageVisible = true
    this.returningToIndex = false
    this.reload()
  }

  destinationHidden(): void {
    this.pageVisible = false
    this.closePanels()
    this.shortcutRefreshGeneration++
    this.shortcutState = ProjectShortcutState.Unknown
  }

  aboutToDisappear(): void {
    this.destinationHidden()
  }

  private reload(): void {
    if (this.projectId.length === 0) { return }
    this.project = store.getProject(this.projectId)
    this.versions = store.listVersions(this.projectId)
    if (this.project === null) {
      this.shortcutRefreshGeneration++
      this.shortcutState = ProjectShortcutState.Unknown
      this.returnToIndex()
      return
    }
    this.reloadWidget()
    this.refreshShortcutState()
  }

  /** The widget as the home-screen card sees it: the latest version (LiveFormService) and the cards bound to it. */
  private reloadWidget(): void {
    let latest = this.versions.length > 0 ? this.versions[0] : null
    let placed = 0
    try { placed = formBindings.formsFor(this.projectId).length } catch (e) {
      console.error('Read widget bindings failed: ' + (e as Error).message)
    }
    this.widget = widgetStatus(latest !== null ? latest.source : '', latest !== null ? latest.vbc2 : '', placed)
    let shows = this.widget.kind === WIDGET_READY || this.widget.kind === WIDGET_PLACED
    this.widgetVbc2 = shows && latest !== null ? latest.vbc2 : ''
    this.widgetSeed = shows && latest !== null ? store.loadState(this.projectId, latest.id, veraStateStamp(latest.vbc2)) : ''
  }

  private returnToIndex(): void {
    if (!this.pageVisible || this.returningToIndex) { return }
    const top = this.pathStack.size() - 1
    if (top < 0 || this.pathStack.getParamByIndex(top) !== this.params) { return }
    try {
      this.returningToIndex = true
      returnToLibrary(this.pathStack)
    } catch (e) {
      this.returningToIndex = false
      console.error('Return to projects failed: ' + (e as Error).message)
    }
  }

  private async refreshShortcutState(): Promise<void> {
    const generation = ++this.shortcutRefreshGeneration
    const projectId = this.projectId
    this.shortcutState = ProjectShortcutState.Unknown
    if (!this.pageVisible || this.projectOperationPending || this.project === null) { return }
    const state = await projectOperations.getShortcutState(projectId)
    if (generation !== this.shortcutRefreshGeneration || projectId !== this.projectId ||
        this.projectOperationPending) { return }
    if (store.getProject(projectId) === null) { this.reload(); return }
    this.shortcutState = state
  }

  private clearPanels(): void {
    this.activePanel = ''
    this.renameComposing = false
    this.viewedSource = ''
    this.viewedPrompt = ''
    this.viewedVersionNumber = 0
    this.viewedMetricsVersion = null
    this.viewedMetricsNumber = 0
  }

  private closePanels(): void {
    this.sourceController.close()
    this.metricsController.close()
    this.renameController.close()
    this.iconController.close()
    this.widgetController.close()
    this.clearPanels()
  }

  private handleBack(): boolean {
    if (this.activePanel.length === 0) { return false }
    this.closePanels()
    return true
  }

  private shortcutButtonLabel(): string {
    if (this.shortcutOperation === 'add') { return 'Adding…' }
    if (this.shortcutOperation === 'remove') { return 'Removing…' }
    if (this.shortcutState === ProjectShortcutState.Present) { return 'Remove shortcut' }
    if (this.shortcutState === ProjectShortcutState.Absent) { return 'Add shortcut' }
    return this.shortcutState === ProjectShortcutState.Failed ? 'Check shortcut' : 'Checking shortcut…'
  }

  build() {
    NavDestination() {
      this.pageContent()
    }
    .title(this.project !== null ? this.project!.name : 'Project')
    .menus([settingsMenuItem(this.pathStack)])
    .backgroundColor(app.background)
    .onBackPressed((): boolean => this.handleBack())
    .onShown(() => { this.destinationShown() })
    .onHidden(() => { this.destinationHidden() })
  }

  @LocalBuilder
  pageContent() {
      Column() {
        if (this.project !== null) {
          Row() {
            // The picture and the name are the controls for changing them: a pencil says so.
            Stack({ alignContent: Alignment.BottomEnd }) {
              Image(projectIconResource(this.project!.icon))
                .width(56).height(56).objectFit(ImageFit.Contain)
              this.pencilBadge()
            }
            .margin({ right: 16 })
            .onClick(() => { this.openIconPicker() })
            Column() {
              Row({ space: 6 }) {
                Text(this.project!.name).fontSize(22).fontWeight(FontWeight.Bold)
                  .maxLines(1).textOverflow({ overflow: TextOverflow.Ellipsis }).flexShrink(1)
                SymbolGlyph($r('sys.symbol.pencil_tip')).fontSize(16).fontColor([app.inkMuted])
              }
              .onClick(() => { this.openRename() })
              Text(versionCountText(this.versions.length))
                .fontSize(14).fontColor(app.inkMuted).margin({ top: 4 })
            }.alignItems(HorizontalAlign.Start).layoutWeight(1)
          }
          .width('100%')
          .padding(16)

          // One thing to do first (Generate), the one next to it (Run), and the rest in a menu.
          Row({ space: 10 }) {
            Button('New version')
              .attributeModifier(new PrimaryButton())
              .layoutWeight(1)
              .onClick(() => { this.openGenerate('') })
            Button('Run')
              .attributeModifier(new TonalButton())
              .layoutWeight(1)
              .enabled(this.latestRunnableIndex() >= 0)
              .onClick(() => { this.runLatest() })
            Button('\u22EF')
              .attributeModifier(new TonalButton())
              .width(52)
              .fontSize(22)
              .enabled(!this.projectOperationPending)
              .bindMenu([
                { value: this.shortcutButtonLabel(), action: () => { this.onShortcutMenu() },
                  enabled: this.shortcutMenuEnabled() },
                { value: 'Rename', action: () => { this.openRename() } },
                { value: 'Delete project', action: () => { this.askDeleteProject() } }
              ])
          }
          .width('100%')
          .padding({ left: 16, right: 16, bottom: 12 })

          if (this.versions.length > 0 && this.latestRunnableIndex() !== 0) {
            Text(this.runSelectionNote())
              .fontSize(12)
              .fontColor(app.warningInk)
              .width('100%')
              .padding({ left: 16, right: 16, bottom: 12 })
          }

          List({ space: 12 }) {
            if (this.versions.length > 0) {
              ListItem() { this.widgetSection() }
                .swipeAction(this.canRemoveWidget() ? { end: { builder: () => { this.removeWidgetAction() } } } : {})
            }
            ForEach(this.versions, (v: Version, index: number) => {
              ListItem() {
                Column() {
                  Column() {
                    Row() {
                      Text('v' + (this.versions.length - index).toString())
                        .fontSize(15).fontWeight(FontWeight.Medium)
                      if (v.vbc2.length === 0) {
                        Text('needs compile')
                          .fontSize(11)
                          .fontColor(app.warningInk)
                          .backgroundColor(app.warningFill)
                          .borderRadius(4)
                          .padding({ left: 6, right: 6, top: 2, bottom: 2 })
                          .margin({ left: 8 })
                      }
                    }
                    // What the app is (the request it began as); and, for a refinement, what this version changed.
                    if (requestHeadline(v.prompt, v.note).length > 0) {
                      Text(requestHeadline(v.prompt, v.note)).fontSize(13).fontColor(app.inkStrong).margin({ top: 2 })
                        .maxLines(1).textOverflow({ overflow: TextOverflow.Ellipsis })
                    }
                    if (changeNote(v.prompt, v.note).length > 0) {
                      Text('Changed: ' + changeNote(v.prompt, v.note)).fontSize(12).fontColor(app.inkSoft).margin({ top: 2 })
                        .maxLines(1).textOverflow({ overflow: TextOverflow.Ellipsis })
                    }
                    Text(new Date(v.createdAt).toLocaleString())
                      .fontSize(12).fontColor(app.inkMuted).margin({ top: 2 })
                  }
                  .alignItems(HorizontalAlign.Start)
                  .width('100%')

                  Row({ space: 6 }) {
                    Button('Run')
                      .attributeModifier(new TonalButton())
                      .height(32)
                      .fontSize(12)
                      .padding({ left: 4, right: 4 })
                      .layoutWeight(1)
                      .enabled(v.vbc2.length > 0)
                      .onClick(() => { this.runVersion(v) })
                    Button('Refine')
                      .attributeModifier(new QuietButton())
                      .height(32)
                      .fontSize(12)
                      .padding({ left: 4, right: 4 })
                      .layoutWeight(1)
                      .onClick(() => { this.openGenerate(v.id) })
                    Button('Code')
                      .attributeModifier(new QuietButton())
                      .height(32)
                      .fontSize(12)
                      .padding({ left: 4, right: 4 })
                      .layoutWeight(1)
                      .onClick(() => { this.viewSource(v, this.versions.length - index) })
                    Button('Metrics')
                      .attributeModifier(new QuietButton())
                      .height(32)
                      .fontSize(12)
                      .padding({ left: 4, right: 4 })
                      .layoutWeight(1)
                      .onClick(() => { this.viewMetrics(v, this.versions.length - index) })
                  }
                  .width('100%')
                  .margin({ top: 8 })
                }
                .width('100%')
                .padding(14)
                .backgroundColor(app.surface)
                .borderRadius(12)
                .shadow({ radius: 2, color: '#10000000', offsetY: 1 })
              }
              .swipeAction({
                end: {
                  builder: () => { this.deleteVersionAction(v) }
                }
              })
            }, (v: Version) => v.id)
          }
          .width('100%')
          .padding({ left: 16, right: 16, top: 12 })
          .layoutWeight(1)
        }

      }.width('100%').height('100%')
  }

  /** The home-screen widget: what it is, and the one next thing to do with it. */
  @LocalBuilder
  widgetSection() {
    Column() {
      Row({ space: 14 }) {
        if (this.widgetVbc2.length > 0) {
          WidgetPreview({ vbc2: this.widgetVbc2, seedState: this.widgetSeed, title: this.project!.name, thumbnail: true })
            .borderRadius(9)
            .onClick(() => { this.previewWidget() })
        } else {
          Column() {
            SymbolGlyph($r(this.widget.kind === WIDGET_BROKEN ? 'sys.symbol.exclamationmark_triangle' : 'sys.symbol.plus'))
              .fontSize(24)
              .fontColor([this.widget.kind === WIDGET_BROKEN ? app.warningInk : app.inkMuted])
          }
          .width(72)
          .height(72)
          .justifyContent(FlexAlign.Center)
          .borderRadius(12)
          .border({ width: 1.5, color: app.lineStrong, style: BorderStyle.Dashed })
        }
        Column({ space: 4 }) {
          Text('Home-screen widget').fontSize(15).fontWeight(FontWeight.Medium).fontColor(app.inkStrong)
          Text(this.widgetLine())
            .fontSize(13)
            .fontColor(this.widget.kind === WIDGET_BROKEN ? app.warningInk :
              (this.widget.kind === WIDGET_PLACED ? app.successInk : app.inkMuted))
            .maxLines(3)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .alignItems(HorizontalAlign.Start)
        .layoutWeight(1)
      }
      .width('100%')

      // The buttons in one row under it, as a version's Run / Refine / Code (Preview first, as Run); Remove is behind a swipe, as a version's Delete.
      if (this.widget.kind === WIDGET_NONE) {
        Row() { this.widgetButton('Make widget', true, () => { this.makeWidget() }) }
          .width('100%').margin({ top: 8 })
      } else if (this.widget.kind === WIDGET_READY) {
        Row({ space: 6 }) {
          this.widgetButton('Preview', true, () => { this.previewWidget() })
          this.widgetButton('Add to home screen', false, () => { this.addWidget() }, 1.8)
          if (this.widget.canRefine) {
            this.widgetButton('Refine', false, () => { this.makeWidget() })
            this.widgetButton('Redo', false, () => { this.makeWidget(true) })
          }
        }
        .width('100%').margin({ top: 8 })
      } else if (this.widget.kind === WIDGET_PLACED) {
        // Refine edits the widget there; Redo writes another from nothing (the cards keep the old one until it is kept).
        Row({ space: 6 }) {
          this.widgetButton('Preview', true, () => { this.previewWidget() })
          if (this.widget.canRefine) {
            this.widgetButton('Refine', false, () => { this.makeWidget() })
            this.widgetButton('Redo', false, () => { this.makeWidget(true) })
          }
          this.widgetButton('Add another', false, () => { this.addWidget() }, 1.4)
        }
        .width('100%').margin({ top: 8 })
      } else if (this.widget.kind === WIDGET_BROKEN && this.versions[0].vbc2.length > 0) {
        Row() { this.widgetButton('Make widget again', true, () => { this.makeWidget() }) }
          .width('100%').margin({ top: 8 })
      }
    }
    .width('100%')
    .padding(14)
    .backgroundColor(app.surface)
    .borderRadius(12)
    .shadow({ radius: 2, color: '#10000000', offsetY: 1 })
  }

  /** A button of the widget block, sized like a version's Run / Refine / Code. */
  @Builder
  widgetButton(label: string, tonal: boolean, action: () => void, weight: number = 1) {
    Button(label)
      .attributeModifier(tonal ? new TonalButton() : new QuietButton())
      .height(32)
      .fontSize(12)
      .padding({ left: 4, right: 4 })
      .layoutWeight(weight)
      .enabled(!this.projectOperationPending)
      .onClick(action)
  }

  private widgetLine(): string {
    let kind = this.widget.kind
    if (kind === WIDGET_READY) { return 'Not on home screen yet' }
    if (kind === WIDGET_PLACED) {
      return '\u2713 On home screen' + (this.widget.placed > 1 ? ' \u00B7 ' + this.widget.placed.toString() + ' cards' : '')
    }
    if (kind === WIDGET_BROKEN) { return 'Your home-screen card shows "Open app": the latest version has no widget.' }
    if (kind === WIDGET_NEEDS_RUN) { return 'The latest version did not finish building. Refine it, then make a widget.' }
    if (kind === WIDGET_UNAVAILABLE) { return 'This app already uses its widget for its own screen, so a separate one cannot be added.' }
    return 'Not made yet'
  }

  private watchForCard(): void {
    let tries = 0
    let tick = (): void => {
      if (!this.pageVisible || this.project === null) { return }
      this.reloadWidget()
      if (this.widget.placed > 0) { return }
      tries++
      if (tries < 60) { setTimeout(tick, 1000) }
    }
    setTimeout(tick, 1000)
  }

  private canRemoveWidget(): boolean {
    return this.widget.canRefine && (this.widget.kind === WIDGET_READY || this.widget.kind === WIDGET_PLACED)
  }

  /** Behind a swipe to the left, as a version's Delete. */
  @LocalBuilder
  removeWidgetAction() {
    Row() {
      Button('Remove')
        .attributeModifier(new DangerButton())
        .height('100%')
        .enabled(!this.projectOperationPending)
        .accessibilityText('Remove widget')
        .onClick(() => { this.confirmRemoveWidget() })
    }.height('100%').padding({ left: 8 })
  }

  /** Cards on the home screen stay (only the launcher removes them), so the person is told before. */
  private confirmRemoveWidget(): void {
    let placed = this.widget.placed
    let cards = placed === 1 ? 'The card on your home screen stays and shows' :
      'The ' + placed.toString() + ' cards on your home screen stay and show'
    let message = 'A new version of the app is saved without its home-screen widget; earlier versions keep theirs.' +
      (placed > 0 ? ' ' + cards + ' "Open app": press and hold ' + (placed === 1 ? 'it' : 'each') + ' to remove it there.' : '')
    this.getUIContext().showAlertDialog({
      title: 'Remove widget?',
      message: message,
      primaryButton: { value: 'Cancel', action: () => {} },
      secondaryButton: { value: 'Remove', fontColor: app.danger, action: () => { this.doRemoveWidget() } }
    })
  }

  /** The latest version, the one the card draws, saved again without its widget, with the app's state carried over. */
  private doRemoveWidget(): void {
    if (this.projectOperationPending) { return }
    let latest = store.getLatestVersion(this.projectId)
    if (latest === null || latest.vbc2.length === 0) { this.reload(); return }
    let removal = removeWidget(latest.source, latest.prompt)
    if (removal.error.length > 0) { this.showProjectMessage(removal.error); return }
    let saved = store.loadState(this.projectId, latest.id, veraStateStamp(latest.vbc2))
    try {
      store.createVersion(this.projectId, removal.source, removal.vbc2, WIDGET_REMOVED_NOTE, removal.prompt, latest.origin,
        latest.composition, '', latest.id, null, saved, veraStateStamp(removal.vbc2))
    } catch (e) {
      this.showProjectMessage('Cannot remove the widget: ' + (e as Error).message)
      return
    }
    this.reload()
    refreshForms()
    this.showProjectMessage('Widget removed')
  }

  /** Make, change or remake the widget: always on the latest version, the one the card draws. Fresh writes a new one. */
  private makeWidget(fresh: boolean = false): void {
    if (!this.widget.canRefine || this.versions.length === 0 || this.versions[0].vbc2.length === 0) { return }
    this.openGenerate(this.versions[0].id, true, fresh)
  }

  @LocalBuilder
  deleteVersionAction(v: Version) {
    Row() {
      Button('Delete')
        .attributeModifier(new DangerButton())
        .height('100%')
        .enabled(!this.projectOperationPending)
        .onClick(() => { this.confirmDeleteVersion(v) })
    }.height('100%').padding({ left: 8 })
  }

  private confirmDeleteVersion(v: Version): void {
    let versions = store.listVersions(v.projectId)
    let index = -1
    for (let i = 0; i < versions.length; i++) {
      if (versions[i].id === v.id) { index = i; break }
    }
    if (index < 0) { this.reload(); return }
    let lastVersion = versions.length === 1
    let shortcutWarning = this.shortcutState === ProjectShortcutState.Present ?
      ' Its desktop shortcut will also be removed.' : ' Any desktop shortcut will also be removed.'
    let message = lastVersion ?
      'This is the only remaining version. Deleting it will also delete the mini-app and all its saved program data.' +
        shortcutWarning + ' This cannot be undone.' :
      'Delete v' + (versions.length - index).toString() + ' and its saved program data? This cannot be undone.'
    this.getUIContext().showAlertDialog({
      title: lastVersion ? 'Delete mini-app?' : 'Delete version?',
      message: message,
      primaryButton: {
        value: 'Cancel',
        action: () => {}
      },
      secondaryButton: {
        value: 'Delete',
        fontColor: app.danger,
        action: () => { this.doDeleteVersion(v) }
      }
    })
  }

  private async doDeleteVersion(v: Version): Promise<void> {
    if (this.projectOperationPending) {
      return;
    }
    this.projectOperationPending = true
    let context = (): common.UIAbilityContext => this.getUIContext().getHostContext() as common.UIAbilityContext
    const status = await projectOperations.deleteVersion(context, v.projectId, v.id)
    this.projectOperationPending = false
    if (status === ProjectOperationStatus.ProjectDeletedShortcutRemovalFailed) {
      this.showProjectMessage('Mini-application was deleted, but its shortcut cannot be removed.')
    }
    this.reload()
    refreshForms();
    if (status === ProjectOperationStatus.ProjectDeleted || status === ProjectOperationStatus.NotFound ||
        status === ProjectOperationStatus.ProjectDeletedShortcutRemovalFailed) {
      this.returnToIndex()
    } else if (status !== ProjectOperationStatus.Success) {
      this.showProjectMessage('Cannot delete version.')
    }
  }

  private latestRunnableIndex(): number {
    for (let i = 0; i < this.versions.length; i++) {
      if (this.versions[i].vbc2.length > 0) { return i }
    }
    return -1
  }

  private runSelectionNote(): string {
    let index = this.latestRunnableIndex()
    if (index < 0) { return 'Run is unavailable: no version has compiled code.' }
    return 'Run will launch v' + (this.versions.length - index).toString() +
      ', the latest compiled version. Newer versions need compilation.'
  }

  private runLatest(): void {
    let index = this.latestRunnableIndex()
    if (index < 0) { return }
    this.runVersion(this.versions[index])
  }

  private runVersion(v: Version): void {
    if (v.vbc2.length === 0) { return }
    let p = new AppRouteParams()
    p.projectId = v.projectId
    p.versionId = v.id
    p.vbc2 = v.vbc2
    this.pathStack.pushPath({ name: 'runner', param: p })
  }

  private openGenerate(baseVersionId: string, makeWidget: boolean = false, widgetFresh: boolean = false): void {
    let p = new AppRouteParams()
    p.projectId = this.projectId
    p.baseVersionId = baseVersionId
    p.makeWidget = makeWidget ? '1' : ''
    p.widgetFresh = makeWidget && widgetFresh ? '1' : ''
    this.pathStack.pushPath({ name: 'generate', param: p })
  }

  private viewSource(v: Version, versionNumber: number): void {
    if (!this.pageVisible || this.activePanel.length > 0) { return }
    this.viewedVersionNumber = versionNumber
    this.viewedSource = v.source
