/**
 * A scene in a section: a picture the app draws itself every frame, moving on its own or touched anywhere -- a wheel that
 * spins, dice that tumble, a ball that rolls, a signature area -- as one part of an ordinary screen of forms and lists. The
 * plan of needs names it (NeedsPlan.ets, type scene), nothing ready draws one, so the section hole writes it
 * (AgentCustom.ets) on a ui.Surface beside the section's own components, and it is played before it is served
 * (VeraSurfacePlay.ets, buttons pressed too: a Spin button beside the wheel is as likely as a tap on it).
 *
 * The rules come from a roulette table written by hand (tools/vera-harness/examples/surface-roulette.vera) and tried on the
 * phone: the controls are components, not drawn; and what the scene decides is settled from the bet locked in when it
 * started -- read from the form when the ball landed, a stake typed during the spin was paid out as if it had been staked.
 */

/** Room for a section with a scene: its fields, its frame, its drawing and its controls. */
export const SCENE_TOKENS: number = 7000

/** The example section, in the form the writer answers in. Kept compiling by tools/vera-harness/scene-hole-check.js. */
export const SCENE_EXAMPLE: string = [
  '<classes>',
  '</classes>',
  '<fields>',
  'c_angle: number = 0',
  'c_speed: number = 0',
  'c_seed: number = 20261030',
  'c_prize: number = -1',
  'c_total: number = 0',
  '</fields>',
  '<functions>',
  'function c_prizes(): number[] {',
  '  return [10, 50, 0, 100, 20, 5, 200, 0];',
  '}',
  '',
  'function c_spin(state: AppState, value: number): AppState {',
  '  if (state.c_speed > 0) {',
  '    return state;',
  '  }',
  '  let seed: number = math.randomStep(state.c_seed);',
  '  return {c_speed: 540 + math.randomBelow(seed, 360), c_seed: seed, c_prize: -1__PASSTHROUGH__};',
  '}',
  '',
  'function c_frame(state: AppState, elapsedMs: number): AppState {',
  '  if (state.c_speed <= 0) {',
  '    return state;',
  '  }',
  '  let dt: number = math.min(elapsedMs, 50) / 1000;',
  '  let angle: number = state.c_angle + state.c_speed * dt;',
  '  angle = angle - 360 * math.floor(angle / 360);',
  '  let speed: number = math.max(0, state.c_speed - 180 * dt);',
  '  if (speed > 0) {',
  '    return {c_angle: angle, c_speed: speed__PASSTHROUGH__};',
  '  }',
  '  // Stopped: the slice under the pointer (screen angle 0) is at 0 - angle in the wheel\'s own frame. Settled here only.',
  '  let under: number = 0 - angle;',
  '  under = under - 360 * math.floor(under / 360);',
  '  let prize: number = c_prizes()[math.floor(under / 45) % 8];',
  '  return {c_angle: angle, c_speed: 0, c_prize: prize, c_total: state.c_total + prize__PASSTHROUGH__};',
  '}',
  '',
  'function c_tap(state: AppState, p: gfx.Pointer): AppState {',
  '  if (p.phase === "up") {',
  '    return c_spin(state, 0);',
  '  }',
  '  return state;',
  '}',
  '',
  'function c_px(a: number, r: number): number {',
  '  return r * math.sin(a * math.pi() / 180);',
  '}',
  '',
  'function c_py(a: number, r: number): number {',
  '  return 0 - r * math.cos(a * math.pi() / 180);',
  '}',
  '',
  'function c_draw(state: AppState): gfx.Shape[] {',
  '  let prizes: number[] = c_prizes();',
  '  let wheel: gfx.Shape[] = [];',
  '  let i: number = 0;',
  '  while (i < 8) {',
  '    let a0: number = i * 45;',
  '    let a1: number = a0 + 45;',
  '    let tone: string = "accent";',
  '    if (i % 2 === 1) {',
  '      tone = "#ffd54a";',
  '    }',
  '    wheel.push(gfx.polygon([0, 0, c_px(a0, 130), c_py(a0, 130), c_px(a0 + 22.5, 130), c_py(a0 + 22.5, 130),',
  '      c_px(a1, 130), c_py(a1, 130)], tone));',
  '    wheel.push(gfx.group(c_px(a0 + 22.5, 92), c_py(a0 + 22.5, 92), a0 + 22.5, 1, 1,',
  '      [gfx.text(0, 0, 18, "center", "ink", ui.numberToString(prizes[i]), true)]));',
  '    i = i + 1;',
  '  }',
  '  wheel.push(gfx.circle(0, 0, 18, "surface"));',
  '  let shapes: gfx.Shape[] = [];',
  '  shapes.push(gfx.group(150, 150, state.c_angle, 1, 1, wheel));',
  '  shapes.push(gfx.arc(150, 150, 130, 0, 360, 4, "ink"));',
  '  shapes.push(gfx.polygon([150, 30, 138, 4, 162, 4], "danger"));',
  '  return shapes;',
  '}',
  '</functions>',
  '<view>',
  'let spinning: boolean = state.c_speed > 0;',
  'sections.push(ui.Section("content", "Prize wheel", "Spin it, or tap the wheel", [',
  '  ui.Surface("default", 300, 300, "c_draw", "c_frame", "c_tap"),',
  '  ui.When(state.c_prize >= 0, ui.Text("title", "You won " + ui.numberToString(state.c_prize))),',
  '  ui.ActionBar("default", [ui.Button("primary", "Spin", "c_spin", 0, !spinning)]),',
  '  ui.NumberText("metric", state.c_total, "", " points in all", 0)',
  ']));',
  '</view>',
].join('\n')

