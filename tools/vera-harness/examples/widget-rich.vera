@jsonable class AppState { taps: number; }

function init(): AppState { return {taps: 0}; }

function scene(state: AppState): gfx.Shape[] {
  let shapes: gfx.Shape[] = [];
  shapes.push(gfx.rect(0, 0, 100, 100, gfx.linear(0, 0, 0, 100, ["#1e1b4b", "#7c3aed", "#f472b6"])));
  shapes.push(gfx.glow(6, "#fde68a", [gfx.circle(80, 18, 6, "#fef9c3")]));
  shapes.push(gfx.blend("add", [
    gfx.circle(26, 30, 9, gfx.radial(26, 30, 9, ["#22d3ee", "#22d3ee00"])),
    gfx.circle(34, 30, 9, gfx.radial(34, 30, 9, ["#f43f5e", "#f43f5e00"]))
  ]));
  shapes.push(gfx.blur(3, [gfx.roundRect(8, 70, 40, 8, 4, "#ffffff55")]));
  shapes.push(gfx.moving("pop", state.taps, 56, 64, [
    gfx.shadow(0, 4, 6, "#00000066", [
      gfx.circle(56, 64, 20, gfx.radial(49, 56, 26, ["#ffffff", "#fde047", "#c2410c"]))
    ]),
    gfx.glow(4, "#22d3ee", [gfx.arc(56, 64, 27, 0, 360, 1.5, "#a5f3fc")])
  ]));
  return shapes;
}

function onTouch(state: AppState, p: gfx.Pointer): AppState {
  if (p.phase !== "down") { return state; }
  return {taps: state.taps + 1};
}

function view(state: AppState): ui.View {
  return ui.AppTheme("playful", "", [
    ui.Surface("default", 100, 100, "scene", "", "onTouch"),
    ui.Text("caption", ui.numberToString(state.taps) + " taps")
  ]);
}

function widget(state: AppState): ui.View {
  return ui.AppTheme("playful", "", [
    ui.Column("center", [
      ui.Surface("default", 100, 100, "scene", "", "onTouch"),
      ui.Text("caption", ui.numberToString(state.taps) + " taps")
    ])
  ]);
}
