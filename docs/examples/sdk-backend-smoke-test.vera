// Hand-written smoke test for the 485 generated sdk.call adapters in
// VeraSdkBackend.ets (tools/generate-sdk-backend.py, docs/sdk-backend-500.md).
//
// Eight targets, picked to span different kits and different call shapes
// (zero and one argument, boolean/int/string return, sync and Promise), all
// read-only queries so running this on a real device is safe to repeat.
// Never generated by the model -- written directly to check the adapters
// without spending a generation cycle per target.

import * as ui from "std/ui"
import * as sdk from "std/sdk"

@jsonable
class AppState {
  screenLocked: string;
  notifEnabled: string;
  hotspotDualBand: string;
  appMemSize: string;
  pipEnabled: string;
  hasNet: string;
  voiceCap: string;
  locEnabled: string;
}

function init(): AppState {
  return {
    screenLocked: "(not run)",
    notifEnabled: "(not run)",
    hotspotDualBand: "(not run)",
    appMemSize: "(not run)",
    pipEnabled: "(not run)",
    hasNet: "(not run)",
    voiceCap: "(not run)",
    locEnabled: "(not run)"
  };
}

function checkScreenLock(state: AppState, ignored: int): AppState {
  sdk.call("BasicServicesKit.screenLock.isDeviceLocked", ["userId", "100"], "onScreenLock");
  return state;
}
function onScreenLock(state: AppState, value: string): AppState {
  return {screenLocked: value, notifEnabled: state.notifEnabled, hotspotDualBand: state.hotspotDualBand, appMemSize: state.appMemSize, pipEnabled: state.pipEnabled, hasNet: state.hasNet, voiceCap: state.voiceCap, locEnabled: state.locEnabled};
}

function checkNotif(state: AppState, ignored: int): AppState {
  sdk.call("NotificationKit.notificationManager.isNotificationEnabled", [], "onNotif");
  return state;
}
function onNotif(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: value, hotspotDualBand: state.hotspotDualBand, appMemSize: state.appMemSize, pipEnabled: state.pipEnabled, hasNet: state.hasNet, voiceCap: state.voiceCap, locEnabled: state.locEnabled};
}

function checkHotspot(state: AppState, ignored: int): AppState {
  sdk.call("ConnectivityKit.wifiManager.isHotspotDualBandSupported", [], "onHotspot");
  return state;
}
function onHotspot(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: state.notifEnabled, hotspotDualBand: value, appMemSize: state.appMemSize, pipEnabled: state.pipEnabled, hasNet: state.hasNet, voiceCap: state.voiceCap, locEnabled: state.locEnabled};
}

function checkAppMem(state: AppState, ignored: int): AppState {
  sdk.call("AbilityKit.appManager.getAppMemorySize", [], "onAppMem");
  return state;
}
function onAppMem(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: state.notifEnabled, hotspotDualBand: state.hotspotDualBand, appMemSize: value, pipEnabled: state.pipEnabled, hasNet: state.hasNet, voiceCap: state.voiceCap, locEnabled: state.locEnabled};
}

function checkPiP(state: AppState, ignored: int): AppState {
  sdk.call("ArkUI.PiPWindow.isPiPEnabled", [], "onPiP");
  return state;
}
function onPiP(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: state.notifEnabled, hotspotDualBand: state.hotspotDualBand, appMemSize: state.appMemSize, pipEnabled: value, hasNet: state.hasNet, voiceCap: state.voiceCap, locEnabled: state.locEnabled};
}

function checkNet(state: AppState, ignored: int): AppState {
  sdk.call("NetworkKit.connection.hasDefaultNet", [], "onNet");
  return state;
}
function onNet(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: state.notifEnabled, hotspotDualBand: state.hotspotDualBand, appMemSize: state.appMemSize, pipEnabled: state.pipEnabled, hasNet: value, voiceCap: state.voiceCap, locEnabled: state.locEnabled};
}

function checkVoice(state: AppState, ignored: int): AppState {
  sdk.call("TelephonyKit.call.hasVoiceCapability", [], "onVoice");
  return state;
}
function onVoice(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: state.notifEnabled, hotspotDualBand: state.hotspotDualBand, appMemSize: state.appMemSize, pipEnabled: state.pipEnabled, hasNet: state.hasNet, voiceCap: value, locEnabled: state.locEnabled};
}

function checkLocation(state: AppState, ignored: int): AppState {
  sdk.call("LocationKit.geoLocationManager.isLocationEnabled", [], "onLocation");
  return state;
}
function onLocation(state: AppState, value: string): AppState {
  return {screenLocked: state.screenLocked, notifEnabled: state.notifEnabled, hotspotDualBand: state.hotspotDualBand, appMemSize: state.appMemSize, pipEnabled: state.pipEnabled, hasNet: state.hasNet, voiceCap: state.voiceCap, locEnabled: value};
}

function view(state: AppState): ui.View {
  return ui.AppTheme("expressive", "", [
    ui.Header("default", "sdk.call smoke test", "8 targets", "Tap each row to run its adapter", "check"),
    ui.Section("content", "", "", [
      ui.KeyValueGroup("default", 1, [
        ui.KeyValueItem("default", "screenLock.isDeviceLocked", state.screenLocked, ""),
        ui.KeyValueItem("default", "notificationManager.isNotificationEnabled", state.notifEnabled, ""),
        ui.KeyValueItem("default", "wifiManager.isHotspotDualBandSupported", state.hotspotDualBand, ""),
        ui.KeyValueItem("default", "appManager.getAppMemorySize", state.appMemSize, ""),
        ui.KeyValueItem("default", "PiPWindow.isPiPEnabled", state.pipEnabled, ""),
        ui.KeyValueItem("default", "connection.hasDefaultNet", state.hasNet, ""),
        ui.KeyValueItem("default", "call.hasVoiceCapability", state.voiceCap, ""),
        ui.KeyValueItem("default", "geoLocationManager.isLocationEnabled", state.locEnabled, "")
      ]),
      ui.ActionBar("spread", [
        ui.Button("secondary", "Screen lock", "checkScreenLock", 0, true),
        ui.Button("secondary", "Notif", "checkNotif", 0, true),
        ui.Button("secondary", "Hotspot", "checkHotspot", 0, true),
        ui.Button("secondary", "App mem", "checkAppMem", 0, true)
      ]),
      ui.ActionBar("spread", [
        ui.Button("secondary", "PiP", "checkPiP", 0, true),
        ui.Button("secondary", "Net", "checkNet", 0, true),
        ui.Button("secondary", "Voice", "checkVoice", 0, true),
        ui.Button("secondary", "Location", "checkLocation", 0, true)
      ])
    ])
  ]);
}
